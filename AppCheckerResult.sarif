{"$schema":"https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.4.json","version":"2.1.0","runs":[{"results":[{"ruleId":"acc-ReadableScreenNameNeeded","ruleIndex":0,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Screen1"}},"logicalLocations":[{"fullyQualifiedName":"Screen1"}],"properties":{"module":"Screen1","type":"Screen1"}}],"properties":{"level":"Low"}},{"ruleId":"acc-AccessibleLabelNeeded","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Screen1.ddroom.AccessibleLabel"}},"logicalLocations":[{"fullyQualifiedName":"Screen1.ddroom.AccessibleLabel"}],"properties":{"module":"Screen1","type":"Screen1.ddroom","member":"AccessibleLabel"}}],"properties":{"level":"Medium"}},{"ruleId":"acc-AccessibleLabelNeeded","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Screen1.txtStart.AccessibleLabel"}},"logicalLocations":[{"fullyQualifiedName":"Screen1.txtStart.AccessibleLabel"}],"properties":{"module":"Screen1","type":"Screen1.txtStart","member":"AccessibleLabel"}}],"properties":{"level":"Medium"}},{"ruleId":"acc-AccessibleLabelNeeded","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Screen1.txtEnd.AccessibleLabel"}},"logicalLocations":[{"fullyQualifiedName":"Screen1.txtEnd.AccessibleLabel"}],"properties":{"module":"Screen1","type":"Screen1.txtEnd","member":"AccessibleLabel"}}],"properties":{"level":"Medium"}},{"ruleId":"acc-AccessibleLabelNeeded","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Screen1.galBookings.AccessibleLabel"}},"logicalLocations":[{"fullyQualifiedName":"Screen1.galBookings.AccessibleLabel"}],"properties":{"module":"Screen1","type":"Screen1.galBookings","member":"AccessibleLabel"}}],"properties":{"level":"Medium"}},{"ruleId":"acc-TabIndexShouldBeDefinedForInteractiveControl","ruleIndex":2,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Screen1.galBookings.TabIndex"}},"logicalLocations":[{"fullyQualifiedName":"Screen1.galBookings.TabIndex"}],"properties":{"module":"Screen1","type":"Screen1.galBookings","member":"TabIndex"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":3,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":3,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"acc-ReadableScreenNameNeeded","messageStrings":{"issue":{"text":"Revise screen name"}},"properties":{"howToFix":["Give the screen  a title that describes what's on the screen or what it's used for."],"whyFix":"People who are blind, have low vision, or a reading disability rely on screen titles to navigate using the screen reader. ","level":"Low","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"Коллекция инициализирована, но не обновляется"}},"properties":{"howToFix":["Замените Collect или ClearCollect на именованную формулу в App.Formulas. Например, MyTable = Filter(source, condition). Именованные формулы вычисляются при изменении их входных данных и не требуют затрат на отслеживание, характерных для коллекций."],"whyFix":"Коллекции предназначены для обновления. Power Apps выполняет дополнительную работу по отслеживанию каждой коллекции, чтобы все, что от нее зависит, оставалось синхронизированным при изменении данных. Если данные не изменяются после их установки, то все эти усилия по отслеживанию оказываются напрасными. Именованная формула позволяет получить те же данные без лишних затрат.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}